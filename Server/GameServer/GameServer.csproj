<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GameServer</AssemblyName>
    <RootNamespace>GameServer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 生成的 protos 与 Google.Protobuf 包里的 WellKnownTypes 反射类同名，本地生成的类型优先，警告可忽略 -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与 Unity 客户端使用相同版本，保证 protobuf / LZ4 编解码完全一致 -->
    <PackageReference Include="Google.Protobuf" Version="3.30.2" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- 直接复用客户端已经生成好的 protobuf C# 代码，协议只维护 Protos/protos 一份 -->
    <Compile Include="..\..\Client\Assets\HotFixScripts\GameMain\Protos\*.cs" Link="Protos\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
