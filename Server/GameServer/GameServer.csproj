<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GameServer</AssemblyName>
    <RootNamespace>GameServer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 生成的 protos 与 Google.Protobuf 包里的 WellKnownTypes 反射类同名，本地生成的类型优先，警告可忽略 -->
    <!-- 部分警告来自直接链接的客户端 ByteBuf / 生成的配置表代码 -->
    <NoWarn>$(NoWarn);CS0436;CS8765;CS8767;CS8618;CS8602;CS8604;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与 Unity 客户端使用相同版本，保证 protobuf / LZ4 编解码完全一致 -->
    <PackageReference Include="Google.Protobuf" Version="3.30.2" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <!-- Recast Navigation 的 C# 移植；导航数据构建与查询使用 DotRecast -->
    <PackageReference Include="DotRecast.Core" Version="2026.3.1" />
    <PackageReference Include="DotRecast.Detour" Version="2026.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 直接复用客户端已经生成好的 protobuf C# 代码，协议只维护 Protos/protos 一份 -->
    <Compile Include="..\..\Client\Assets\HotFixScripts\GameMain\Protos\*.cs" Link="Protos\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      配置表代码直接链接客户端生成目录，Luban 导出后服务端自动使用同一份 C#，
      不需要再复制到 Server。
    -->
    <Compile Include="..\..\Client\Assets\HotFixScripts\GameMain\Config\Gen\*.cs" Link="Config\Gen\%(Filename)%(Extension)" />
    <!-- TbLanguageCfg 引用的配置 Bean 生成在 Framework/Localization 下 -->
    <Compile Include="..\..\Client\Assets\HotFixScripts\Framework\Localization\LanguageCfg.cs" Link="Config\Gen\LanguageCfg.cs" />

    <!-- 配置表运行时基础类（不含 Unity 依赖，且 TableBase 已抽成独立文件） -->
    <Compile Include="..\..\Client\Assets\HotFixScripts\Framework\Config\BeanBase.cs" Link="Config\Framework\BeanBase.cs" />
    <Compile Include="..\..\Client\Assets\HotFixScripts\Framework\Config\ITypeId.cs" Link="Config\Framework\ITypeId.cs" />
    <Compile Include="..\..\Client\Assets\HotFixScripts\Framework\Config\ByteBuf.cs" Link="Config\Framework\ByteBuf.cs" />
    <Compile Include="..\..\Client\Assets\HotFixScripts\Framework\Config\StringUtil.cs" Link="Config\Framework\StringUtil.cs" />
    <Compile Include="..\..\Client\Assets\HotFixScripts\Framework\Config\TableBase.cs" Link="Config\Framework\TableBase.cs" />

    <!-- 客户端/服务端共用的地图数据二进制格式和建筑类型判断 -->
    <Compile Include="..\..\Client\Assets\HotFixScripts\GameMain\Map\MapData\MapDataBinary.cs" Link="Map\MapDataBinary.cs" />
    <Compile Include="..\..\Client\Assets\HotFixScripts\GameMain\Map\MapData\MapBuildingTypeHelper.cs" Link="Map\MapBuildingTypeHelper.cs" />
    <Compile Include="..\..\Client\Assets\HotFixScripts\GameMain\Map\MapData\GateProtocolCodes.cs" Link="Map\GateProtocolCodes.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unity 导出的导航数据，发布时一起拷贝 -->
    <None Include="..\NavData\navmesh.rnav" Link="NavData\navmesh.rnav"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
